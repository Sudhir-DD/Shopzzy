<div class="modal-overlay" id="priceAlertModal">
    <div class="modal-card">
        <button type="button" class="round-btn round-btn-sm modal-close" id="priceAlertModalClose" aria-label="Close"><%- include('icon', { icon: 'close', size: 16 }) %></button>

        <div class="modal-icon"><%- include('icon', { icon: 'bell', size: 26 }) %></div>
        <h2 id="priceAlertModalTitle">Set a Price Alert</h2>
        <p class="modal-current-price">
            Currently <strong id="priceAlertModalCurrentPrice">₹0</strong>
        </p>

        <div class="modal-input-row">
            <span class="currency">₹</span>
            <input type="number" id="priceAlertModalInput" min="1" step="1" placeholder="Target price" inputmode="numeric">
        </div>

        <p class="modal-hint" id="priceAlertModalHint" aria-live="polite">We’ll notify you the moment the price drops to this amount or below.</p>

        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" id="priceAlertModalCancel">Cancel</button>
            <button type="button" class="btn btn-primary" id="priceAlertModalSubmit">Set Alert</button>
        </div>
    </div>
</div>
