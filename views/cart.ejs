<%- include('partials/head', { title: 'Your Cart - Shopzy' }) %>
<%- include('partials/header') %>

<main class="page-wrap">
    <div class="page-top">
        <a class="round-btn" href="/" aria-label="Continue shopping"><%- include('partials/icon', { icon: 'arrowLeft', size: 20 }) %></a>
        <span class="page-top-title">Shopping cart</span>
        <a class="round-btn" href="/" aria-label="Close cart"><%- include('partials/icon', { icon: 'close', size: 18 }) %></a>
    </div>

    <h1 class="page-title">Your Cart</h1>

    <div id="cartList"></div>

    <div id="cartSummary"></div>

    <template id="emptyCartTemplate">
        <%- include('partials/state', {
            mood: 'sad',
            title: 'Empty Cart',
            text: 'Your cart feels lonely.',
            prop: 'heartCrack',
            actions: [{ label: 'Start Shopping', href: '/' }]
        }) %>
    </template>
</main>

<%- include('partials/footer') %>
<%- include('partials/foot') %>

<script>
    let cartState = <%- JSON.stringify({ items: items, total: total }).replace(/</g, '\\u003c') %>;

    const CLOSE_ICON =
        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';
    const ARROW_ICON =
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';

    function formatPrice(n) {
        return '₹' + n.toLocaleString('en-IN');
    }

    function renderCart() {
        const listEl = document.getElementById('cartList');
        const summaryEl = document.getElementById('cartSummary');

        if (cartState.items.length === 0) {
            listEl.innerHTML = document.getElementById('emptyCartTemplate').innerHTML;
            summaryEl.innerHTML = '';
            return;
        }

        const itemCount = cartState.items.reduce(function (sum, item) { return sum + item.quantity; }, 0);

        listEl.innerHTML = cartState.items
            .map(function (item) {
                return (
                    '<div class="cart-item" data-item-id="' + item.id + '">' +
                        '<a class="thumb stage" href="/product/' + item.product_id + '"><img src="/' + item.image + '" alt="' + item.name + '"></a>' +
                        '<div class="info">' +
                            '<h2>' + item.name + '</h2>' +
                            '<p>' + formatPrice(item.price) + ' each</p>' +
                        '</div>' +
                        '<div class="qty-control">' +
                            '<button type="button" data-qty-dec aria-label="Decrease quantity">−</button>' +
                            '<span>' + item.quantity + '</span>' +
                            '<button type="button" data-qty-inc aria-label="Increase quantity">+</button>' +
                        '</div>' +
                        '<p class="price">' + formatPrice(item.price * item.quantity) + '</p>' +
                        '<button type="button" class="round-btn round-btn-sm" data-remove aria-label="Remove ' + item.name + '" title="Remove">' + CLOSE_ICON + '</button>' +
                    '</div>'
                );
            })
            .join('');

        summaryEl.innerHTML =
            '<div class="cart-summary">' +
                '<div class="summary-total">' +
                    '<span class="muted">Total · ' + itemCount + ' item' + (itemCount === 1 ? '' : 's') + '</span>' +
                    '<strong>' + formatPrice(cartState.total) + '</strong>' +
                '</div>' +
                '<button type="button" class="btn btn-primary btn-lg" id="checkoutBtn">Checkout ' + ARROW_ICON + '</button>' +
            '</div>';

        document.getElementById('checkoutBtn').addEventListener('click', checkout);
    }

    function updateQuantity(itemId, quantity) {
        api('/api/cart/' + itemId, { method: 'PATCH', body: { quantity: quantity } })
            .then(function (data) {
                cartState = data;
                renderCart();
                updateCartBadge();
            })
            .catch(function (err) {
                showToast(err.message);
            });
    }

    function removeItem(itemId) {
        api('/api/cart/' + itemId, { method: 'DELETE' })
            .then(function (data) {
                cartState = data;
                renderCart();
                updateCartBadge();
                showToast('Item removed from cart.');
            })
            .catch(function (err) {
                showToast(err.message);
            });
    }

    function checkout() {
        api('/api/checkout', { method: 'POST' })
            .then(function (data) {
                cartState = { items: [], total: 0 };
                renderCart();
                updateCartBadge();
                showOrderPlaced(data.orderId);
            })
            .catch(function (err) {
                if (isServerOrNetworkError(err)) {
                    showPaymentFailed(checkout);
                } else {
                    showToast(err.message);
                }
            });
    }

    document.getElementById('cartList').addEventListener('click', function (e) {
        const row = e.target.closest('[data-item-id]');

        if (!row) {
            return;
        }

        const itemId = row.getAttribute('data-item-id');
        const item = cartState.items.find(function (i) { return String(i.id) === itemId; });

        if (e.target.closest('[data-qty-inc]')) {
            updateQuantity(itemId, item.quantity + 1);
        } else if (e.target.closest('[data-qty-dec]')) {
            updateQuantity(itemId, item.quantity - 1);
        } else if (e.target.closest('[data-remove]')) {
            removeItem(itemId);
        }
    });

    renderCart();
</script>
