<%- include('partials/head', { title: 'Your Orders - Shopzy' }) %>
<%- include('partials/header') %>

<main class="page-wrap">
    <div class="page-top">
        <a class="round-btn" href="/" aria-label="Back to home"><%- include('partials/icon', { icon: 'arrowLeft', size: 20 }) %></a>
    </div>

    <h1 class="page-title">Orders &amp; Returns</h1>

    <% if (orders.length === 0) { %>
        <%- include('partials/state', {
            mood: 'thinking',
            title: 'No Orders Yet',
            text: 'When you place an order, it will show up here.',
            prop: 'box',
            actions: [{ label: 'Start Shopping', href: '/' }]
        }) %>
    <% } else { %>
        <% orders.forEach(function (order) { %>
            <div class="order-card">
                <div class="order-head">
                    <div>
                        <span class="order-id">Order #<%= order.id %></span>
                        <span class="order-date"><%= new Date(order.created_at + ' UTC').toLocaleString() %></span>
                    </div>
                    <span class="order-total">₹<%= order.total.toLocaleString('en-IN') %></span>
                </div>

                <% order.items.forEach(function (item) { %>
                    <div class="order-line">
                        <span class="thumb stage"><img src="/<%= item.image %>" alt="<%= item.name %>"></span>
                        <div class="info">
                            <div class="order-item-name"><%= item.name %></div>
                            <div class="desc">Qty: <%= item.quantity %> × ₹<%= item.price.toLocaleString('en-IN') %></div>
                        </div>
                        <div class="price">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></div>
                    </div>
                <% }) %>
            </div>
        <% }) %>
    <% } %>
</main>

<%- include('partials/footer') %>
<%- include('partials/foot') %>
